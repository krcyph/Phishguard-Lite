# Backend environment variables
# Copy this file to .env and fill in the values.
#
# PORT
#   The port the Express server listens on.
#   Render sets this automatically — do NOT hard-code it.
#
PORT=4000

# FRONTEND_URL
#   The origin of the deployed Vercel frontend, used for CORS.
#   - Local development: leave blank (all localhost origins are allowed automatically)
#   - Production: https://your-frontend-name.vercel.app
#
FRONTEND_URL=https://your-frontend-name.vercel.app
